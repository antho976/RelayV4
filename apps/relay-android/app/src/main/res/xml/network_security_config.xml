<?xml version="1.0" encoding="utf-8"?>
<!--
    The paired PC is reached at whatever address its pairing link names: a LAN or Tailscale IP,
    over Relay's plain ws:// door (docs/MOBILE.md §6 says what that door does and does not
    protect). Those addresses cannot be listed ahead of time, so plain traffic is allowed; the app
    has no other network code to send anything over it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
