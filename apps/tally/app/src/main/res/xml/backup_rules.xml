<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8.0 to 8.1. One set of rules covers both the cloud backup and a device transfer here,
    and a device this old cannot tell them apart, so nothing is backed up at all: every domain is
    excluded (with no rule, everything would be). Android 9 to 11 read xml-v28/backup_rules.xml,
    which keeps the device transfer; Android 12 and up read data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
